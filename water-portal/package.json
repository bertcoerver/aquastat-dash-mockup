{
  "name": "water-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test vite.config.ts",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "tiles": "./scripts/build-tiles.sh",
    "postinstall": "patch-package",
    "lists": "node scripts/build-lists.mjs",
    "country-info": "node scripts/build-country-info.mjs",
    "rivers": "node scripts/build-rivers.mjs",
    "dams": "node scripts/build-dams.mjs",
    "deploy": "./scripts/deploy-pages.sh"
  },
  "dependencies": {
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/extensions": "~9.4.0",
    "@deck.gl/geo-layers": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/mapbox": "~9.4.0",
    "@deck.gl/mesh-layers": "~9.4.0",
    "@developmentseed/deck.gl-geotiff": "0.9.0",
    "@developmentseed/deck.gl-raster": "0.9.0",
    "@developmentseed/geotiff": "0.9.0",
    "@loaders.gl/core": "~4.5.4",
    "@loaders.gl/mvt": "~4.5.4",
    "@luma.gl/core": "~9.4.2",
    "@luma.gl/shadertools": "~9.4.2",
    "@math.gl/web-mercator": "^4.1.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "maplibre-gl": "5.24.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "eslint": "^10.13.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.63.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
