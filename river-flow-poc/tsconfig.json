{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@portal/*": ["../water-portal/src/*"],
      "@portal-data/*": ["../water-portal/public/data/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
